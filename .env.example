# ─── Легион — окружение ─────────────────────────────────────────────────
# Скопируй в .env для локальной разработки (или задай в Railway → Variables).
# БЕЗ BOT_TOKEN сервер работает в DEV-режиме: авторизация подменяется одним
# локальным пользователем. Удобно для локальных прогонов (соло против ботов
# вообще не требует сервера).

# От @BotFather (/newbot). Обязателен в продакшене.
BOT_TOKEN=

# Публичный HTTPS-адрес приложения (Railway выдаёт его сам),
# например https://legion-production.up.railway.app
# Нужен для вебхука Telegram и кнопки «Играть».
APP_URL=

# @username бота без @ (для ссылок-приглашений в комнату).
BOT_USERNAME=legion_play_bot

# Секретный сегмент пути вебхука Telegram (любая случайная строка).
WEBHOOK_SECRET=change-me-to-something-random

# Подписывает сессионные JWT (любая длинная случайная строка).
JWT_SECRET=change-me-to-a-long-random-string

# Где лежит SQLite. На Railway укажи смонтированный том, например /data
DATA_DIR=./data

# Порт (Railway задаёт автоматически).
PORT=3000
